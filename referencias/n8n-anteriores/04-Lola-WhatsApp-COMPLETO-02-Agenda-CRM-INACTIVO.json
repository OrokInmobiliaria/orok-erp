    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"reply\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"profile\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"name\": {\n          \"type\": [\"string\", \"null\"]\n        },\n        \"phone\": {\n          \"type\": [\"string\", \"null\"]\n        },\n        \"email\": {\n          \"type\": [\"string\", \"null\"]\n        },\n        \"interest\": {\n          \"type\": [\"string\", \"null\"]\n        },\n        \"purchase_method\": {\n          \"type\": [\"string\", \"null\"]\n        },\n        \"initial_payment\": {\n          \"type\": [\"string\", \"null\"]\n        }\n      },\n      \"required\": [\n        \"name\",\n        \"phone\",\n        \"email\",\n        \"interest\",\n        \"purchase_method\",\n        \"initial_payment\"\n      ]\n    },\n    \"handoff\": {\n      \"type\": \"boolean\"\n    },\n    \"opt_out\": {\n      \"type\": \"boolean\"\n    },\n    \"commercial_answer\": {\n      \"type\": \"boolean\"\n    },\n    \"commercial_evidence\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"tool\": {\n            \"type\": \"string\"\n          },\n          \"data\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\"tool\", \"data\"]\n      }\n    }\n  },\n  \"required\": [\n    \"reply\",\n    \"profile\",\n    \"handoff\",\n    \"opt_out\",\n    \"commercial_answer\",\n    \"commercial_evidence\"\n  ]\n}"
      },
