          "name": "Header Auth account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw=$input.first().json;const body=raw.body||raw;\nif(body.action==='connection_check')return [{json:{action:'connection_check'}}];\nif(body.object!=='whatsapp_business_account')return [];\nconst output=[];\nfor(const e of body.entry||[])for(const c of e.changes||[]){const v=c.value||{},account=String(v.metadata?.phone_number_id||'');\n if(!['messages','smb_message_echoes'].includes(c.field))continue;\n const echo=c.field==='smb_message_echoes';\n for(const m of (echo?v.message_echoes:v.messages)||[]){const phone=String(echo?m.to:m.from||'').replace(/\\D/g,'');if(!phone||!m.id||!account)continue;\n output.push({json:{action:'whatsapp_message',business_phone_id:account,phone,name:(v.contacts||[]).find(x=>x.wa_id===phone)?.profile?.name||'',referral:m.referral||null,message:{id:m.id,at:m.timestamp,direction:echo?'outbound':'inbound',sender:echo?'Equipo · WhatsApp/Mac':'Cliente',type:m.type,text:m.text?.body||m.button?.text||m.interactive?.button_reply?.title||m.interactive?.list_reply?.title||'',button_id:m.interactive?.button_reply?.id||m.interactive?.list_reply?.id||m.button?.payload||null,media:m[m.type]||null}}});}\n for(const s of v.statuses||[])if(['sent','delivered','read','failed'].includes(s.status))output.push({json:{action:'whatsapp_status',business_phone_id:account,message_id:s.id,status:s.status,at:s.timestamp}});\n}\nif(output.length>100)throw Error('Lote mayor a 100 eventos');return output;\n"
      },
