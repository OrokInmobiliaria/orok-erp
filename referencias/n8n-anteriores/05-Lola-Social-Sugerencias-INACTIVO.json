        "jsCode": "const j=$('Conservar trabajo').first().json;const input=$input.first().json;let agent;try{agent=$('Lola Social').first().json;}catch{agent={};}const steps=Array.isArray(agent.intermediateSteps)?agent.intermediateSteps:[];const observed=steps.filter(s=>s.observation!==undefined).map(s=>({tool:String(s.action?.tool||s.tool||''),data:typeof s.observation==='string'?s.observation:JSON.stringify(s.observation)}));return [{json:{action:'social_job_complete',job_id:j.id,lease_token:j.lease_token,...(input.error||agent.error?{error:'generation_failed'}:{result:{output:input.output,observed_evidence:observed}})}}];"
