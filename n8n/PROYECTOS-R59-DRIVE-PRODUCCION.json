    {
      "id": "19cdc134-38cd-4a37-8f28-0d226db5d9f3",
      "name": "Resolver coincidencia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        440
      ],
      "parameters": {
        "jsCode": "return $input.all().map((it,i)=>{const j=$('Conservar trabajo Drive').itemMatching(i).json;const rows=(it.json.files||[]).filter(f=>f.mimeType===j.mime);if(rows.length>1)throw Error('Más de un elemento idéntico; revisar sin borrar.');if(rows[0]&&j.kind==='file'&&Number(rows[0].size)!==Number(j.size))throw Error('El archivo existente no coincide en tamaño.');return {json:{file:rows[0]||null},pairedItem:{item:i}};});"
      }
    },
