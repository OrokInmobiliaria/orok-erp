        1440,
        220
      ],
      "parameters": {
        "jsCode": "const rows=[];for(let i=0;i<$input.all().length;i++){const b=await this.helpers.getBinaryDataBuffer(i,'data');rows.push({json:{text:b.toString('utf8').slice(0,30000)},pairedItem:{item:i}});}return rows;"
      }
    },
    {
      "id": "f3c4d2be-79fd-4570-ad9e-53931f62accf",
      "name": "Preparar textos por trabajo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        440
      ],
      "parameters": {
        "jsCode": "const out=new Map();for(let i=0;i<$input.all().length;i++){const item=$input.all()[i];const j=$('Conservar trabajo Drive').itemMatching(i).json;let v=out.get(j.id);if(!v){v={json:{job_id:j.id,lease_token:j.lease_token,text:''},pairedItem:{item:i}};out.set(j.id,v);}v.json.text+=(item.json.text||JSON.stringify(item.json))+'\\n';v.json.text=v.json.text.slice(0,30000);}return [...out.values()];"
      }
    },
